{
  "name": "github-repo-search",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build-only": "vite build",
    "preview": "vite preview",
    "test:all": "npm run test:unit && npm run test:component && npm run test:e2e",
    "test:unit": "vitest run",
    "test:component": "cypress run --component --browser chrome",
    "test:e2e": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress run --e2e --browser chrome'",
    "cy:open": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --browser chrome'",
    "cy:prepare": "cypress install",
    "type-check": "vue-tsc --build",
    "lint": "run-p type-check && run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "axios": "^1.16.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@cypress/vue": "^6.0.3",
    "@testing-library/cypress": "^10.1.3",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.4",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.14.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-cypress": "^6.3.1",
    "eslint-plugin-oxlint": "~1.60.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.60.0",
    "prettier": "3.8.3",
    "sass": "^1.100.0",
    "sass-embedded": "^1.100.0",
    "start-server-and-test": "^2.1.5",
    "typescript": "~6.0.0",
    "vite": "^8.0.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.7",
    "vue-tsc": "^3.2.6",
    "vuetify": "^4.0.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
